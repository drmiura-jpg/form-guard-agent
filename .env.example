# Form-Guard Agent — Environment Variables Example (.env.example)
# Copy this file to .env and fill in values only if you want to run live Anthropic API calls.
# By default, Form-Guard Agent works completely offline (--mode demo / auto fallback) without any API key.
# Never commit your actual .env file.

# Optional: Dedicated Anthropic API key for Form-Guard live mode (or run: pwsh scripts/setup_api_key.ps1)
FORM_GUARD_API_KEY=

# Optional: Standard Anthropic API key fallback for live mode
ANTHROPIC_API_KEY=

# Set to 1 to force offline deterministic demo mode even when an API key is present (default: 0)
FORM_GUARD_FORCE_DEMO=0

# Optional: Path to a local .mp4 walkthrough video served at GET /media/demo.mp4 on /start
FORM_GUARD_DEMO_VIDEO=

# Model routing tier in live mode: auto / opus / sonnet / haiku (empty = auto)
FORM_GUARD_MODEL_TIER=

# Multi-model tiering switch: auto / off (empty = auto; off = one model, Opus, for every call)
# Set only one of the two: a non-empty FORM_GUARD_MODEL_TIER wins over FORM_GUARD_MODEL_TIERING
FORM_GUARD_MODEL_TIERING=

# Optional: Pin a single explicit model ID for all calls in live mode
FORM_GUARD_MODEL=

# Output effort level for supported models: low | medium | high | max (default: medium)
FORM_GUARD_EFFORT=medium

# Server-side refusal fallback opt-in for supported models: 1 | 0 (default: 1)
FORM_GUARD_FALLBACKS=1
