# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Test / tool caches
.pytest_cache/
.coverage
htmlcov/

# Secrets — never commit API keys
.env
.env.*

# Generated pipeline outputs (re-create with: python -m form_guard.cli --all-demos)
output/

# Scratch git worktrees (e.g. .worktrees/phase2) — never part of the repository
.worktrees/

# Personal Claude Code settings (the shared project settings are .claude/settings.json)
.claude/settings.local.json

# OS / editor / backup noise
.DS_Store
Thumbs.db
.idea/
.vscode/
~$*
*.bak
*.bak-*
